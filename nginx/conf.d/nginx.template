# =========================================================
# DJANGO UPSTREAM
# =========================================================
upstream django_backend {

    least_conn;

    server web1:8000 max_fails=3 fail_timeout=30s;
    server web2:8000 max_fails=3 fail_timeout=30s;
    server web3:8000 max_fails=3 fail_timeout=30s;
    server web4:8000 max_fails=3 fail_timeout=30s;

    keepalive 64;
}

# =========================================================
# DAPHNE UPSTREAM
# =========================================================
upstream daphne_backend {

    least_conn;

    server daphne1:8001 max_fails=3 fail_timeout=30s;
    server daphne2:8001 max_fails=3 fail_timeout=30s;
    server daphne3:8001 max_fails=3 fail_timeout=30s;

    keepalive 32;
}

# =========================================================
# SERVER
# =========================================================
server {

    listen 80 reuseport;
    listen [::]:80 reuseport;

    server_name _;

    # =====================================================
    # HEALTH
    # =====================================================
    location = /health/ {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
# =====================================================
# STATIC FILES
# =====================================================
location /static/ {

    alias /staticfiles/;

    access_log off;
    log_not_found off;

    try_files $uri =404;

    expires 365d;

    add_header Cache-Control "public, max-age=31536000, immutable";

    # Prevent access to sensitive files
    location ~* \.(env|ini|log|sql|bak|swp)$ {
        deny all;
    }
}

# =====================================================
# MEDIA FILES
# =====================================================
location /media/ {

    alias /media/;

    access_log off;
    log_not_found off;

    try_files $uri =404;

    expires 12h;

    add_header Cache-Control "public, max-age=43200";

    location ~* \.(env|ini|log|sql|bak|swp)$ {
        deny all;
    }
}
}

    # =====================================================
    # LOGIN
    # =====================================================
    location = /accounts/login/ {

        limit_req zone=login_limit burst=20 nodelay;
        limit_conn conn_limit 10;

        proxy_pass http://django_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # =====================================================
    # WEBSOCKETS
    # =====================================================
    location /ws/ {

        limit_req zone=ws_limit burst=50 nodelay;

        proxy_pass http://daphne_backend;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;

        proxy_buffering off;
    }

    # =====================================================
    # MAIN APPLICATION
    # =====================================================
    location / {

        limit_req zone=global_limit burst=200 nodelay;
        limit_conn conn_limit 50;

        proxy_pass http://django_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
    }

    # =====================================================
    # HIDDEN FILES
    # =====================================================
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # =====================================================
    # SENSITIVE FILES
    # =====================================================
    location ~* \.(env|ini|log|sql|bak|old|swp|yml|yaml)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    # =====================================================
    # COMMON ATTACKS
    # =====================================================
    location ~* /(wp-admin|wp-login|phpmyadmin|xmlrpc\.php) {
        deny all;
        return 403;
    }

    # =====================================================
    # NGINX STATUS
    # =====================================================
    location = /nginx_status {

        stub_status;

        allow 127.0.0.1;
        allow ::1;

        deny all;

        access_log off;
    }

    # =====================================================
    # ERROR PAGES
    # =====================================================
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;

    location = /404.html {
        internal;
        return 404 "404 Not Found\n";
    }

    location = /50x.html {
        internal;
        return 500 "Server Error\n";
    }
}